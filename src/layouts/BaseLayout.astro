---
const { title, description, canonical, schemas = [], lastUpdated } = Astro.props;
const canonicalHref = canonical && !canonical.endsWith("/") ? canonical + "/" : canonical;
const ogImage = "https://learn.zero.university/og-default.png";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="Bx2sZmq_4JqQNDtnzC4zShDLNZ8FOsNQZaCvdZpdy9c" />
  <meta name="google-site-verification" content="JK3_N3KdLKDtT3JOleUOIPqR3IXiapvFZNhOFQyqmfU" />
  <meta name="msvalidate.01" content="797C8EA7BF9EC95D44D7E5186F7F8305" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalHref} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Faculty+Glyphic&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/global.css" />
  <script is:inline>document.documentElement.classList.add("js");</script>
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <header>
    <div class="container">
      <a href="/" class="wordmark">zero <span class="mono-label" style="margin:0;color:var(--fg-3);">LEARN</span></a>
      <nav>
        <a href="/learn">Library</a>
        <a href="/learn/zero-vs-forage-which-is-better-for-getting-hired">Compare</a>
        <a href="https://www.zero.university" class="brand">zero.university</a>
      </nav>
    </div>
  </header>
  <main class="container">
    <article class="sheet">
      <slot />
      {lastUpdated && (
        <div class="last-updated">Last updated: {lastUpdated}.</div>
      )}
    </article>
  </main>
  <footer class="editorial">
    <div class="inner">
      <p class="cta">Proof beats pedigree.<br /><em>Build yours.</em></p>
      <nav>
        <a href="https://www.zero.university">zero.university</a>
        <a href="/learn">The library</a>
        <a href="/learn/what-is-a-job-simulation-and-is-it-worth-it">What is a job simulation?</a>
        <a href="/learn/is-zero-free-for-students">Is zero free?</a>
      </nav>
      <div class="micro">
        <span>zero — the talent organization</span>
        <span>learn.zero.university</span>
      </div>
    </div>
  </footer>
  <script is:inline>
  (function(){
    var mainEl = document.querySelector("article.sheet") || document.body;
    // tag reveal targets (h1, capsule, tldr, sections, tables) without touching page source
    var targets = mainEl.querySelectorAll("h1, .answer-capsule, .tldr, article.sheet > section, section, table");
    var seen = 0;
    targets.forEach(function(el){ if(!el.hasAttribute("data-rv") && seen < 60){ el.setAttribute("data-rv",""); seen++; } });
    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) { e.target.classList.add("rv-in"); io.unobserve(e.target); }
        });
      }, { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });
      document.querySelectorAll("[data-rv]").forEach(function(el){ io.observe(el); });
    } else {
      document.querySelectorAll("[data-rv]").forEach(function(el){ el.classList.add("rv-in"); });
    }
    // FAQ accordion (q toggles its sibling a)
    document.querySelectorAll(".faq-q").forEach(function(q){
      q.addEventListener("click", function(){
        q.classList.toggle("open");
        var a = q.nextElementSibling;
        if (a && a.classList.contains("faq-a")) a.classList.toggle("open");
      });
    });
    // read-time into the byline
    var byline = document.querySelector(".byline");
    if (byline) {
      var words = (mainEl.textContent || "").trim().split(/\s+/).length;
      var mins = Math.max(3, Math.round(words / 220));
      var span = document.createElement("span");
      span.textContent = mins + " min read";
      byline.insertBefore(span, byline.firstChild);
    }
  })();
  </script>
</body>
</html>
