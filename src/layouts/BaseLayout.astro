---
const { title, description, canonical, schemas = [], lastUpdated } = Astro.props;
const canonicalHref = canonical && !canonical.endsWith("/") ? canonical + "/" : canonical;
const ogImage = "https://learn.zero.university/og-default.png";
const isHub = ["/learn", "/learn/", "/"].includes(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="Bx2sZmq_4JqQNDtnzC4zShDLNZ8FOsNQZaCvdZpdy9c" />
  <meta name="google-site-verification" content="JK3_N3KdLKDtT3JOleUOIPqR3IXiapvFZNhOFQyqmfU" />
  <meta name="msvalidate.01" content="797C8EA7BF9EC95D44D7E5186F7F8305" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalHref} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="preload" href="/fonts/bureauSerif.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="stylesheet" href="/global.css" />
  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <header class="site">
    <div class="z-wrap">
      <a href="/" class="wordmark">zero <span class="z-label">learn</span></a>
      <nav>
        <a href="/learn">Library</a>
        <a href="/learn/zero-vs-forage-which-is-better-for-getting-hired">Compare</a>
        <a href="https://www.zero.university" class="z-btn z-btn--primary" style="padding:10px 20px;font-size:14px;">zero.university</a>
      </nav>
    </div>
  </header>
  {isHub ? (
    <main class="hub">
      <slot />
    </main>
  ) : (
    <main class="article">
      <div class="z-wrap">
        <article>
          <slot />
          {lastUpdated && <div class="last-updated">Last updated: {lastUpdated}.</div>}
        </article>
      </div>
    </main>
  )}
  <div class="z-marquee" aria-hidden="true">
    <div class="z-marquee__track">
      <div class="z-marquee__seg">
        <span>proof beats pedigree</span><span class="z-dot"></span>
        <span>get hired with zero experience</span><span class="z-dot"></span>
        <span>evidence beats claims</span><span class="z-dot"></span>
        <span>the work is the resume</span><span class="z-dot"></span>
      </div>
      <div class="z-marquee__seg">
        <span>proof beats pedigree</span><span class="z-dot"></span>
        <span>get hired with zero experience</span><span class="z-dot"></span>
        <span>evidence beats claims</span><span class="z-dot"></span>
        <span>the work is the resume</span><span class="z-dot"></span>
      </div>
    </div>
  </div>
  <footer class="z-footer">
    <div class="z-wrap" style="padding-top:clamp(80px,9vw,130px);padding-bottom:48px;text-align:center;">
      <span class="z-label" style="color:rgba(255,255,255,0.5);">the talent organization</span>
      <h2 class="z-display" style="color:#fff;font-size:clamp(44px,5.5vw,88px);margin:24px 0 28px;">Proof beats <span class="z-hl" style="background:var(--green-300);color:var(--green-900);">pedigree.</span></h2>
      <p class="z-lead" style="color:rgba(255,255,255,0.6);max-width:520px;margin:0 auto 40px;">Real company-shaped work, scored against a professional bar, shown to the people who hire. Free for students, always.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:72px;">
        <a class="z-btn z-btn--primary" style="background:#fff;color:var(--fg-1);" href="https://www.zero.university">Go to zero.university</a>
        <a class="z-btn z-btn--ghost" style="color:#fff;border-color:rgba(255,255,255,0.3);" href="/learn">Browse the library</a>
      </div>
      <div style="border-top:1px solid rgba(255,255,255,0.08);padding-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <span class="z-label" style="color:rgba(255,255,255,0.4);">&copy; zero 2026 &middot; proof beats pedigree</span>
        <span class="z-label" style="color:rgba(255,255,255,0.4);">learn.zero.university</span>
      </div>
    </div>
  </footer>
  <script is:inline>
  /* ===== adapter: upgrade generated guide markup to spec patterns (enhancement only) ===== */
  (function () {
    var art = document.querySelector("main.article article");
    var ARROW = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>';
    if (art) {
      /* §07 meta row after the dek */
      var cap = art.querySelector(".answer-capsule");
      var by = art.querySelector(".byline");
      if (cap) {
        var updated = "";
        if (by) { var m = (by.textContent || "").match(/(\d{4}-\d{2}-\d{2})/); if (m) updated = m[1]; }
        var words = (art.textContent || "").trim().split(/\s+/).length;
        var meta = document.createElement("div");
        meta.className = "z-meta";
        meta.innerHTML = '<span class="src"><span class="z-dot"></span>Primary-sourced</span><span>' +
          Math.max(3, Math.round(words / 220)) + ' min read</span>' + (updated ? '<span>Updated ' + updated + '</span>' : '');
        cap.parentNode.insertBefore(meta, cap.nextSibling);
      }
      /* §12 FAQ — rebuild q/a pairs into accordion structure */
      art.querySelectorAll(".faq-q").forEach(function (q) {
        var a = q.nextElementSibling;
        if (!a || !a.classList.contains("faq-a")) return;
        var item = document.createElement("div"); item.className = "z-faq__item";
        var btn = document.createElement("button"); btn.type = "button"; btn.className = "z-faq__btn";
        btn.innerHTML = '<span class="z-faq__q"></span><span class="z-faq__icon">+</span>';
        btn.querySelector(".z-faq__q").textContent = q.textContent;
        var bodyWrap = document.createElement("div"); bodyWrap.className = "z-faq__body";
        var inner = document.createElement("div");
        var ans = document.createElement("div"); ans.className = "z-faq__a"; ans.innerHTML = a.innerHTML;
        inner.appendChild(ans); bodyWrap.appendChild(inner);
        item.appendChild(btn); item.appendChild(bodyWrap);
        q.parentNode.insertBefore(item, q); q.remove(); a.remove();
      });
      /* related rows */
      art.querySelectorAll(".related li a").forEach(function (a) {
        a.classList.add("z-row");
        var t = document.createElement("span"); t.className = "z-row__title"; t.textContent = a.textContent;
        a.textContent = ""; a.appendChild(t); a.insertAdjacentHTML("beforeend", ARROW);
      });
      /* stage reveals */
      var n = 0;
      art.querySelectorAll("h1, .answer-capsule, .z-meta, .tldr, section").forEach(function (el) {
        if (n < 60 && !el.hasAttribute("data-reveal")) { el.setAttribute("data-reveal", String((n % 3) * 110)); n++; }
      });
    }
    document.querySelectorAll(".lib-cat, .lib-hero > *").forEach(function (el, i) {
      if (!el.hasAttribute("data-reveal")) el.setAttribute("data-reveal", String((i % 3) * 110));
    });
  })();
  /* ===== § Behavior JS (handoff spec, verbatim) ===== */
  (function () {
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cinema = 'cubic-bezier(0.16, 1, 0.3, 1)';
    function kick(a){ try { a.startTime = document.timeline.currentTime; } catch(e){} return a; }
    if (!reduced) {
      var items = [].slice.call(document.querySelectorAll('[data-reveal]'));
      var done = new Set();
      function reveal(el, useDelay) {
        if (done.has(el)) return; done.add(el);
        var d = useDelay ? (parseInt(el.getAttribute('data-reveal'),10) || 0) : 0;
        kick(el.animate(
          [{opacity:0, transform:'translateY(26px)'},{opacity:1, transform:'translateY(0)'}],
          {duration:820, delay:d, easing:cinema, fill:'backwards'}));
      }
      var fired = false;
      var io = new IntersectionObserver(function(es){
        fired = true;
        es.forEach(function(e){ if (e.isIntersecting){ io.unobserve(e.target); reveal(e.target, true); } });
      }, {threshold:0.12, rootMargin:'0px 0px -40px 0px'});
      items.forEach(function(el){ io.observe(el); });
      setTimeout(function(){ if (!fired){ io.disconnect(); items.forEach(function(el){ reveal(el,false); }); } }, 1500);
    }
    if (!reduced) {
      [].slice.call(document.querySelectorAll('[data-word]')).forEach(function(w,i){
        kick(w.animate(
          [{opacity:0, filter:'blur(12px)', transform:'translateY(16px)'},
           {opacity:1, filter:'blur(0)',    transform:'translateY(0)'}],
          {duration:700, delay:120+i*110, easing:cinema, fill:'backwards'}));
      });
    }
    var cio = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if (!e.isIntersecting) return;
        var el = e.target; cio.unobserve(el);
        var target = parseFloat(el.getAttribute('data-count'));
        var pre = el.getAttribute('data-prefix')||'', suf = el.getAttribute('data-suffix')||'';
        var dur = reduced ? 0 : 1700, t0 = performance.now();
        (function tick(t){
          var p = dur ? Math.min(1,(t-t0)/dur) : 1, eased = 1-Math.pow(1-p,4);
          el.textContent = pre + Math.round(target*eased).toLocaleString() + suf;
          if (p<1) requestAnimationFrame(tick);
        })(t0);
      });
    }, {threshold:0.6});
    [].slice.call(document.querySelectorAll('[data-count]')).forEach(function(el){ cio.observe(el); });
    if (!reduced) {
      var pels = [].slice.call(document.querySelectorAll('[data-parallax]'));
      var ticking = false;
      function upd(){
        ticking = false;
        pels.forEach(function(el){
          var f = parseFloat(el.getAttribute('data-parallax'))||0;
          var r = el.getBoundingClientRect(), prev = el._pOff||0;
          var off = -(((r.top-prev)+r.height/2) - innerHeight/2) * f;
          el._pOff = off;
          if (el._pA) el._pA.cancel();
          el._pA = kick(el.animate(
            [{transform:'translateY('+off.toFixed(1)+'px)'},{transform:'translateY('+off.toFixed(1)+'px)'}],
            {duration:1, fill:'forwards'}));
        });
      }
      addEventListener('scroll', function(){ if(!ticking){ ticking=true; requestAnimationFrame(upd); } }, {passive:true});
      upd();
    }
    [].slice.call(document.querySelectorAll('.z-faq__btn')).forEach(function(btn){
      btn.addEventListener('click', function(){
        var item = btn.closest('.z-faq__item'), open = item.classList.contains('is-open');
        [].slice.call(item.parentNode.querySelectorAll('.z-faq__item.is-open'))
          .forEach(function(o){ o.classList.remove('is-open'); });
        if (!open) item.classList.add('is-open');
      });
    });
  })();
  </script>
</body>
</html>
