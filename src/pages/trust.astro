      {
        "@type": "Question",
        "name": "How are reviewers verified?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Reviewers submit proof of performance (senior role, notable output, or verified industry ranking). Zero audits a random sample of reviews weekly."
