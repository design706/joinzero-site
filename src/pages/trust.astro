        "@type": "Question",
        "name": "How is scoring calibrated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The rubric for each task is built from internal evaluation frameworks used by the company that sourced the task. We do not use generic rubrics."
        }
