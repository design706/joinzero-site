        "name": "What data does Zero collect?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Task submissions, rubric scores, reviewer feedback, and basic profile data (name, email, education). We do not track browsing behavior across the web."
        }
      },
      {
        "@type": "Question",
        "name": "How is data anonymized for public materials?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Students are never named in public case studies. Universities are anonymized until explicit written clearance is given. Aggregated data is reported in ranges, not exact counts, until cleared."
        }
      },
      {
        "@type": "Question",
        "name": "Can students dispute a score?",
        "acceptedAnswer": {
          "@type": "Answer",
