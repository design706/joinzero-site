---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "How Zero works — from task to receipt in 4 steps";
const description = "Zero works in four steps: pick a task, do real work, get scored against the top 1%, and let recruiters see your receipt.";
const canonical = "https://www.joinzero.ai/how-it-works";
const schemas = [{"@context": "https://schema.org", "@type": "Article", "headline": "How Zero works — from task to receipt in 4 steps", "url": "https://www.joinzero.ai/how-it-works", "dateModified": "2026-05-17", "author": {"@type": "Organization", "name": "Zero"}, "publisher": {"@type": "Organization", "name": "Zero", "url": "https://www.joinzero.ai"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.joinzero.ai/"}, {"@type": "ListItem", "position": 2, "name": "How it works", "item": "https://www.joinzero.ai/how-it-works"}]}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "How is a Zero task different from a case study?", "acceptedAnswer": {"@type": "Answer", "text": "Case studies are pre-written scenarios. Zero tasks use real company operations. You might optimize a real checkout flow, not a fictional one."}}, {"@type": "Question", "name": "Who scores my work?", "acceptedAnswer": {"@type": "Answer", "text": "Industry professionals at the top 1% of their field compare your submission to real work they have reviewed. They score on quality, clarity, and completeness."}}, {"@type": "Question", "name": "How fast do I get scored?", "acceptedAnswer": {"@type": "Answer", "text": "Most receipts are returned within 72 hours. Some are instant if the task has an automated quality gate."}}, {"@type": "Question", "name": "Do recruiters actually look at receipts?", "acceptedAnswer": {"@type": "Answer", "text": "Recruiters pay for access to the Zero platform specifically to evaluate receipts before scheduling interviews. That is the business model."}}]}];
---
<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <nav class="breadcrumb"><a href="/">Home</a> / How it works</nav>
  <h1>How does Zero work?</h1>
  <p class="answer-capsule">Zero works in four steps: you pick a task built from a real company operation, you do the work, your submission is scored against the top 1% of professionals, and recruiters see your receipt before they see your resume.</p>

  <div class="tldr">
    <ul>
      <li>Pick a task from a real company operation.</li>
      <li>Do the work at your own pace.</li>
      <li>Get scored against top-1% professionals.</li>
      <li>Recruiters evaluate your receipt before scheduling interviews.</li>
    </ul>
  </div>

  <section>
    <h2>Step 1: Pick a task</h2>
    <p>Each task is extracted from an active company operation. You are not solving a fictional case. You are working on a problem that a team at Stripe, Shopify, or Tesla has already solved internally. The task includes context, constraints, and a deliverable.</p>
    <p><em>Placeholder: screenshot of task picker to be added.</em></p>
  </section>

  <section>
    <h2>Step 2: Do real work</h2>
    <p>You submit a real piece of work: a strategy doc, a wireframe, a spreadsheet, a brief. The system expects professional output, not multiple-choice answers. You can save drafts and return later.</p>
    <p><em>Placeholder: screenshot of submission interface to be added.</em></p>
  </section>

  <section>
    <h2>Step 3: Get scored against the top 1%</h2>
    <p>Your work is reviewed by professionals in the top 1% of their field. They score it on a rubric built from real internal evaluations at the company that sourced the task. You get a score, specific feedback, and a percentile ranking.</p>
    <p><em>Placeholder: example receipt card to be added.</em></p>
  </section>

  <section>
    <h2>Step 4: Recruiters see your receipts</h2>
    <p>Recruiters pay to access the Zero platform. When they search for candidates, they see receipts first and resumes second. A receipt tells them what you can do. A resume only tells them where you studied.</p>
    <p><em>Placeholder: recruiter dashboard mockup to be added.</em></p>
  </section>

  <section class="faq-block">
    <h2>Frequently asked questions</h2>
    <div class="faq-item"><div class="faq-q">How is a Zero task different from a case study?</div><div class="faq-a">Case studies are pre-written scenarios. Zero tasks use real company operations. You might optimize a real checkout flow, not a fictional one.</div></div><div class="faq-item"><div class="faq-q">Who scores my work?</div><div class="faq-a">Industry professionals at the top 1% of their field compare your submission to real work they have reviewed. They score on quality, clarity, and completeness.</div></div><div class="faq-item"><div class="faq-q">How fast do I get scored?</div><div class="faq-a">Most receipts are returned within 72 hours. Some are instant if the task has an automated quality gate.</div></div><div class="faq-item"><div class="faq-q">Do recruiters actually look at receipts?</div><div class="faq-a">Recruiters pay for access to the Zero platform specifically to evaluate receipts before scheduling interviews. That is the business model.</div></div>
  </section>

  <section class="last-updated">Last updated: 2026-05-17</section>
</BaseLayout>
