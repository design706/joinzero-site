---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Learn — The Zero knowledge base";
const description = "The Zero library of cornerstones, guides, and deep dives on skills-based hiring, career simulation, and real work.";
const canonical = "https://learn.zero.university/learn";
const schemas = [{"@context": "https://schema.org", "@type": "Article", "headline": "Learn — The Zero knowledge base", "url": "https://learn.zero.university/learn", "dateModified": "2026-05-17", "author": {"@type": "Organization", "name": "Zero"}, "publisher": {"@type": "Organization", "name": "Zero", "url": "https://learn.zero.university"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://learn.zero.university/"}, {"@type": "ListItem", "position": 2, "name": "Learn", "item": "https://learn.zero.university/learn"}]}];
---
<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <nav class="breadcrumb"><a href="/">Home</a> / Learn</nav>
  <h1>What is the Zero library?</h1>
  <p class="answer-capsule">The Learn section is where Zero publishes deep guides, research, and cornerstones on skills-based hiring, career simulation, and how to break into work without experience.</p>

  <div class="tldr">
    <ul>
      <li>Ring 1 cornerstones: deep, authoritative guides.</li>
      <li>Ring 2 clusters: topic-based collections.</li>
      <li>Ring 3 programmatic pages: data-driven entry points.</li>
    </ul>
  </div>

  <h2>Ring 1 cornerstones</h2>
  <ul>
    <li><a href="/learn/how-do-you-prove-you-can-do-the-job-before-you-have-the-job">How do you prove you can do the job before you have the job?</a></li>
    <li><a href="/learn/how-does-a-virtual-job-simulation-compare-to-a-real-internship">How does a virtual job simulation compare to a real internship?</a></li>
    <li><a href="/learn/how-does-performance-based-hiring-work-for-students">How does performance-based hiring work for students?</a></li>
    <li><a href="/learn/how-do-top-1-percent-junior-marketers-designers-pms-actually-work">How do top 1% junior marketers, designers, and PMs actually work?</a></li>
    <li><a href="/learn/how-to-get-a-product-internship-at-stripe-as-a-first-time-applicant">How to get a product internship at Stripe as a first-time applicant</a></li>
    <li><a href="/learn/how-to-get-a-marketing-internship-at-tesla-with-no-experience">How to get a marketing internship at Tesla with no experience</a></li>
    <li><a href="/learn/is-a-portfolio-better-than-a-resume-for-breaking-into-tech-in-2026">Is a portfolio better than a resume for breaking into tech in 2026?</a></li>
    <li><a href="/learn/what-do-recruiters-look-at-when-a-student-has-no-work-experience">What do recruiters look at when a student has no work experience?</a></li>
    <li><a href="/learn/what-makes-fresh-grads-unhireable-and-how-to-fix-it">What makes fresh grads so incredibly unhireable and how to fix it</a></li>
    <li><a href="/learn/what-should-i-do-this-summer-if-i-didnt-get-an-internship">What should I do this summer if I didn't get an internship?</a></li>
    <li><a href="/learn/where-do-recruiters-actually-find-first-time-candidates-in-2026">Where do recruiters actually find first-time candidates in 2026?</a></li>
  </ul>

  <h2>Ring 2 comparisons and alternatives</h2>
  <ul>
    <li><a href="/learn/forage-alternative-for-students">The best Forage alternative for students in 2026</a></li>
    <li><a href="/learn/is-pathrise-worth-it">Is Pathrise worth it? A real comparison for students</a></li>
    <li><a href="/learn/zero-vs-forage-which-is-better-for-getting-hired">Zero vs Forage: which is better for getting hired?</a></li>
  </ul>

  <section class="last-updated">Last updated: 2026-05-17</section>
</BaseLayout>
