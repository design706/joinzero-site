---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Learn — zero";
const description = "Proof beats pedigree. Honest, primary-sourced answers on getting hired when the degree stopped being enough: why the old path broke, what replaced the resume, how to break in, and how the options really compare.";
const canonical = "https://learn.zero.university/learn";
const schemas = [
  { "@context": "https://schema.org", "@type": "CollectionPage", "name": "zero Learn", "url": canonical, "description": description, "isPartOf": { "@type": "WebSite", "name": "zero", "url": "https://www.zero.university" } }
];
