---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Zero: Do Real Work. Get Recruited.";
const description = "Zero is the simulator where students do real work for real companies, get scored against the top 1% of professionals, and get recruited based on receipts.";
const canonical = "https://www.joinzero.ai/";
const schemas = [{"@context": "https://schema.org", "@type": "Article", "headline": "Zero: Do Real Work. Get Recruited.", "url": "https://www.joinzero.ai/", "dateModified": "2026-05-17", "author": {"@type": "Organization", "name": "Zero"}, "publisher": {"@type": "Organization", "name": "Zero", "url": "https://www.joinzero.ai"}}, {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.joinzero.ai/"}]}, {"@context": "https://schema.org", "@type": "Organization", "name": "Zero", "url": "https://www.joinzero.ai", "logo": "https://www.joinzero.ai/logo.png", "sameAs": ["https://www.linkedin.com/company/110372181/"]}];
---
<BaseLayout title={title} description={description} canonical={canonical} schemas={schemas}>
  <section style="text-align:center; padding: 2rem 0;">
    <h1 style="font-size:2.4rem; margin-bottom:1rem;">Do real work. Get recruited.</h1>
    <p style="font-size:1.15rem; color:var(--color-text-secondary); max-width:620px; margin: 0 auto 1.5rem;">
      Zero is the simulator where students do real work for real companies, get scored against the top 1% of professionals, and get recruited based on receipts.
    </p>
    <a href="/how-it-works" class="cta">Start your first task</a>
  </section>

  <section style="margin-top: 3rem;">
    <h2>What is the wedge between Zero and the alternatives?</h2>
    <p>Forage gives you a certificate. Zero gives you a receipt: a piece of work a real recruiter can evaluate against the top 1% of the industry. Companies use the receipt to decide who to interview. The certificate just sits in your LinkedIn profile.</p>

    <div class="tldr">
      <ul>
        <li>Free for students. Recruiters pay for access to scored receipts.</li>
        <li>Tasks built around real company operations, not generic case studies.</li>
        <li>Every submission is scored against top-1% professionals, not peer averages.</li>
      </ul>
    </div>
  </section>

  <section style="margin-top: 2.5rem;">
    <h2>What proof do we have so far?</h2>
    <div class="proof-card">
      <strong>Pilot signal</strong><br/>
      A Middle East university pilot, Spring 2026, around 200 students, activated immediately when the intro was collapsed to a single "pick your first task" screen. Before that, students bounced within 90 seconds. After the fix, they stayed.
    </div>
    <div class="proof-card">
      <strong>Feedback-driven retention</strong><br/>
      Students returned specifically to see feedback on their own submission. Generic skill assessments were ignored. Per-submission feedback drove every return visit.
    </div>
    <div class="proof-card">
      <strong>Scoring as the hook</strong><br/>
      In the pilot, students said the scoring against real professionals was the reason they came back. It was not the content library. It was not the certificates. It was the score.
    </div>
  </section>
</BaseLayout>
